{
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.6.1" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "bargauge", "name": "Bar gauge", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "datasource", "uid": "grafana" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "target": { "limit": 100, "matchAny": false, "tags": [], "type": "dashboard" },
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": null,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 101,
      "panels": [],
      "title": "Summary",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
      "description": "Distinct hosts with at least one filesystem the recording rule sees. Expected 9 — matches verify.sh metrics.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green" } ] }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "11.6.1",
      "targets": [
        {
          "editorMode": "code",
          "expr": "count(count by (instance) (node_filesystem:usage_ratio))",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Hosts monitored",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
      "description": "Mounts tracked by node_filesystem:usage_ratio after the fstype filter. Measured 2026-10-09: 23 (db 3/3/3, app-01 3, app-02 3, minio 3, redis 2, cicd 2, keycloak 1). A drop here means node_exporter stopped exporting a mount — fix the exporter, not this dashboard.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green" } ] }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "11.6.1",
      "targets": [
        {
          "editorMode": "code",
          "expr": "count(node_filesystem:usage_ratio)",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Mounts tracked",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
      "description": "Alerts firing right now. Green zero = healthy. `or vector(0)` keeps it at 0 instead of No data when nothing fires — an empty count reads as a broken panel otherwise.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [ { "color": "green" }, { "color": "red", "value": 1 } ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "11.6.1",
      "targets": [
        {
          "editorMode": "code",
          "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Firing alerts",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
      "description": "Filesystems the kernel dropped read-only. Normally 0; any non-zero value means I/O errors — check dmesg and SMART. Uses the WIDER DiskReadOnly filter (iso9660|romfs|cramfs|erofs|vfat included) so /boot/efi mounted ro by design never counts.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [ { "color": "green" }, { "color": "red", "value": 1 } ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "11.6.1",
      "targets": [
        {
          "editorMode": "code",
          "expr": "count(node_filesystem_readonly{fstype!~\"tmpfs|overlay|squashfs|ramfs|fuse.*|nsfs|iso9660|romfs|cramfs|erofs|vfat\"} == 1) or vector(0)",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Read-only mounts",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 102,
      "panels": [],
      "title": "Usage by mount",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
      "description": "Thresholds are the alert thresholds verbatim: 0.85 = DiskFillingUp, 0.95 = DiskCriticallyFull. A red bar always means an alert is firing. Value shown as a raw ratio (percentunit) so panel, PromQL and alert expression read the same number.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "max": 1,
          "min": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "rgba(50, 172, 45, 0.97)" },
              { "color": "rgba(237, 129, 40, 0.89)", "value": 0.85 },
              { "color": "rgba(245, 54, 54, 0.9)", "value": 0.95 }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 12, "w": 12, "x": 0, "y": 6 },
      "id": 5,
      "options": {
        "displayMode": "basic",
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": false },
        "maxVizHeight": 300,
        "minVizHeight": 10,
        "minVizWidth": 0,
        "namePlacement": "auto",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true,
        "sizing": "auto",
        "text": {},
        "valueMode": "color"
      },
      "pluginVersion": "11.6.1",
      "targets": [
        {
          "editorMode": "code",
          "expr": "node_filesystem:usage_ratio{instance=~\"$instance\"}",
          "format": "time_series",
          "instant": true,
          "legendFormat": "{{instance}} {{mountpoint}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Used % by mount",
      "type": "bargauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
      "description": "Coverage list — exactly the series the recording rule sees, no filter repeated here so it cannot drift from prometheusrule-disk.yaml. Each row is a mount an alert protects. Sorted by used % descending; colour cells carry the same 0.85/0.95 thresholds as the bargauge.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green" } ] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Used %" },
            "properties": [
              { "id": "unit", "value": "percentunit" },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "rgba(50, 172, 45, 0.97)" },
                    { "color": "rgba(237, 129, 40, 0.89)", "value": 0.85 },
                    { "color": "rgba(245, 54, 54, 0.9)", "value": 0.95 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "gridPos": { "h": 12, "w": 12, "x": 12, "y": 6 },
      "id": 6,
      "options": {
        "cellHeight": { "mode": "sm" },
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "header": { "show": true }
      },
      "pluginVersion": "11.6.1",
      "targets": [
        {
          "editorMode": "code",
          "expr": "node_filesystem:usage_ratio{instance=~\"$instance\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Mount inventory",
      "type": "table",
      "transformations": [
        {
          "id": "sortBy",
          "options": { "fields": {}, "sort": [ { "field": "Value", "desc": true } ] }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "job": true },
            "indexByName": {
              "instance": 0,
              "mountpoint": 1,
              "device": 2,
              "fstype": 3,
              "Value": 4
            },
            "renameByName": {
              "instance": "Host",
              "mountpoint": "Mount",
              "device": "Device",
              "fstype": "Fstype",
              "Value": "Used %"
            }
          }
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 103,
      "panels": [],
      "title": "Trend",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
      "description": "Threshold lines at 0.85 and 0.95 are drawn from the same thresholds as the alerts. Sustained downward slope toward the line is what DiskWillFillIn24h projects 24h forward — a disk can sit at 60% and still be alerting if it is filling fast.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "barWidthFactor": 0.6,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "line" }
          },
          "mappings": [],
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green" },
              { "color": "rgba(237, 129, 40, 0.89)", "value": 0.85 },
              { "color": "rgba(245, 54, 54, 0.9)", "value": 0.95 }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 19 },
      "id": 7,
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "hideZeros": false, "mode": "multi", "sort": "desc" }
      },
      "pluginVersion": "11.6.1",
      "targets": [
        {
          "editorMode": "code",
          "expr": "node_filesystem:usage_ratio{instance=~\"$instance\"}",
          "format": "time_series",
          "instant": false,
          "legendFormat": "{{instance}} {{mountpoint}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Used % over time",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 28 },
      "id": 104,
      "panels": [],
      "title": "Alerts",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
      "description": "Currently firing alerts with the labels they page with. Reads the same $labels.instance / $labels.mountpoint the notification renders, so panel and message match character for character. EMPTY TABLE = NOTHING FIRING, not a broken query.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green" } ] }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 29 },
      "id": 8,
      "options": {
        "cellHeight": { "mode": "sm" },
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "header": { "show": true }
      },
      "pluginVersion": "11.6.1",
      "targets": [
        {
          "editorMode": "code",
          "expr": "ALERTS{alertstate=\"firing\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Firing alerts",
      "type": "table",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Value": true, "job": true },
            "indexByName": {
              "alertname": 0,
              "severity": 1,
              "instance": 2,
              "mountpoint": 3,
              "fstype": 4
            },
            "renameByName": {
              "alertname": "Alert",
              "severity": "Severity",
              "instance": "Host",
              "mountpoint": "Mount",
              "fstype": "Fstype",
              "alertstate": "State"
            }
          }
        }
      ]
    }
  ],
  "refresh": "1m",
  "schemaVersion": 41,
  "tags": ["linux", "disk"],
  "templating": {
    "list": [
      {
        "current": {},
        "includeAll": false,
        "label": "Datasource",
        "hide": "hideVariable",
        "name": "ds_prometheus",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      },
      {
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
        "definition": "label_values(node_filesystem:usage_ratio, instance)",
        "includeAll": true,
        "label": "Host",
        "name": "instance",
        "options": [],
        "query": {
          "query": "label_values(node_filesystem:usage_ratio, instance)",
          "refId": "Prometheus-instance-Variable-Query"
        },
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "timezone": "browser",
  "title": "Disk Usage",
  "uid": "disk-usage",
  "version": 1,
  "weekStart": ""
}
